erf.prob_name = "userdefined"

erf.init_type = "Isentropic"

max_step = 300
stop_time = 2.0

amrex.fpe_trap_invalid = 1
erf.fix_random_seed = 1

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 64.0 64.0 400.0
geometry.is_periodic = 1 1 0

amr.n_cell = 16 16 80
amr.max_level = 0
amr.max_grid_size = 80
amr.blocking_factor = 4
amr.v = 0

zlo.type = "SlipWall"
zhi.type = "SlipWall"
zlo.theta = 300.0
zhi.theta = 300.0

erf.moisture_model = "MoistNoCondensation"
erf.use_gravity = true
erf.fixed_dt = 0.01
erf.molec_diff_type = "None"
erf.les_type = "None"
erf.sum_interval = -1
erf.v = 0

erf.plot_int_1 = -1
erf.plot_int_2 = -1
erf.check_int = -1

prob.rho_0 = 1.0
prob.T_0 = 300.0
prob.U_0 = 1.0
prob.V_0 = 0.0
prob.W_0 = 0.0

fire.enabled = true
fire.coupling_mode = "two_way"
fire.wind_mode = "direct_reference"
fire.reference_height_agl_m = 10.0

fire.fuel_model = "FM1"
fire.dead_fuel_moisture_fraction = 0.08

fire.ignition_center_m = 32.0 32.0
fire.ignition_radius_m = 8.0
fire.ignition_vertex_count = 128

fire.remesh_min_edge_length_m = 0.10
fire.remesh_max_edge_length_m = 0.50
fire.remesh_max_chord_error_m = 0.01
fire.arrival_time_tolerance_s = 1.0e-7
fire.combustion_temporal_substeps = 16
fire.feedback_extinction_depth_m = 25.0

fire.output_dir = "fire_output"
fire.output_interval_steps = 100
